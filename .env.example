# --- upstream services (required) ------------------------------------------
# Use routable IPs. Short hostnames like "kiwix" only resolve inside the
# container if it shares the host's DNS search domain (see docker-compose.yml).
# The addresses below are RFC 5737 documentation placeholders -- replace them
# with the real IPs of your own Kiwix and Ollama hosts.
KIWIX_BASE_URL=http://192.0.2.10
OLLAMA_BASE_URL=http://192.0.2.20:11434

# Must already be pulled on the Ollama host. `ollama list` to check.
# qwen3:8b is a good consumer-GPU default; anything 7B-14B Q4_K_M works.
OLLAMA_MODEL=qwen3:8b

# --- generation ------------------------------------------------------------
# Must be sent explicitly. Ollama's own default is 4096, which silently
# truncates long articles and summarises only the opening section.
OLLAMA_NUM_CTX=24576
OLLAMA_NUM_CTX_LONG=32768
LONG_ARTICLE_TOKENS=20000
OLLAMA_TEMPERATURE=0.2

# Keep weights resident so the first request after idle does not pay a cold
# load (measured ~13s on an RTX 3060). Use "5m" to reclaim VRAM instead.
OLLAMA_KEEP_ALIVE=-1

# Thinking models return an EMPTY response if left in thinking mode: they
# spend the whole num_predict budget on reasoning. Keep this false.
OLLAMA_THINK=false

# Below this target length a single pass overshoots badly (n=40 produced 65
# words), so draft wide then compress in a cheap second pass.
TWO_PASS_BELOW_WORDS=120

# Small models overshoot word targets by ~35% regardless of phrasing, so
# re-compress with feedback on the previous count until within tolerance.
MAX_CORRECTION_PASSES=3

# --- source limits ---------------------------------------------------------
MAX_SOURCE_WORDS=60000

# --- service ---------------------------------------------------------------
# One worker: a single GPU serialises inference, more workers only contend.
LLM_WORKERS=1
QUEUE_MAX=64
JOB_TTL_SECONDS=3600
# Generous on purpose. A warm article fetch is milliseconds, but the first read
# of a page from a cold ZIM is disk-bound and has been seen to exceed 30s.
HTTP_TIMEOUT_SECONDS=60
LLM_TIMEOUT_SECONDS=900
CORS_ORIGINS=*
